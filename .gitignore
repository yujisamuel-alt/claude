# ---------------------------------------------------------------------------
# Unity (baseado no .gitignore oficial github/gitignore/Unity.gitignore)
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures pode ser usado pelo Memory Profiler
/[Mm]emoryCaptures/

# Recordings pode ser usado pelo Unity Recorder
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Autogerado pelo VS Code / Rider / Visual Studio
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Metas de arquivos ignorados acima
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables (gerado pelo Localization)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Sistema operacional
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Projeto Enxada & Encrenca
# ---------------------------------------------------------------------------
# Harness .NET que compila e testa a lógica pura fora da Unity.
# (os .csproj dele são exceção à regra *.csproj acima)
!Tools/LogicTests/**/*.csproj
Tools/LogicTests/**/bin/
Tools/LogicTests/**/obj/
Tools/LogicTests/TestResults/
